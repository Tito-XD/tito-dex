/* TitoDex 全局样式：蓝灰 / 奶油色系 */
page {
  background: #fff7e6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #2f4361;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 属性 chip */
.type-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #ffffff;
  white-space: nowrap;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border: 2rpx solid #afc7da;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.muted {
  color: #7b91a6;
}

/* 图片加载失败占位 */
.img-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f3e4b3;
  border-radius: 12rpx;
  color: #7b91a6;
  font-size: 24rpx;
}
