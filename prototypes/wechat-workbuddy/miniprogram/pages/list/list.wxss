.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---- 顶栏 ---- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff7e6;
  padding: 16rpx 24rpx 8rpx;
  border-bottom: 2rpx solid #f3e4b3;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #afc7da;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #2f4361;
}

.search-placeholder {
  color: #7b91a6;
  font-size: 24rpx;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #7b91a6;
  font-size: 32rpx;
}

.filter-btn {
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #2f4361;
  color: #fff7e6;
  border-radius: 12rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.filter-btn-active {
  background: #f7d977;
  color: #2f4361;
}

/* ---- 筛选面板 ---- */
.filter-panel {
  margin-top: 16rpx;
  background: #ffffff;
  border: 2rpx solid #afc7da;
  border-radius: 16rpx;
  padding: 16rpx 20rpx 20rpx;
}

.filter-title {
  font-size: 24rpx;
  color: #7b91a6;
  margin: 8rpx 0;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 6rpx 22rpx;
  border: 2rpx solid #afc7da;
  border-radius: 999rpx;
  background: #fff7e6;
  font-size: 24rpx;
  color: #2f4361;
}

.chip-on {
  background: #2f4361;
  color: #fff7e6;
  border-color: #2f4361;
}

.filter-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.reset-btn {
  display: inline-block;
  padding: 8rpx 28rpx;
  border: 2rpx solid #2f4361;
  border-radius: 12rpx;
  color: #2f4361;
  font-size: 26rpx;
  background: #f7d977;
}

/* ---- 计数 ---- */
.count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 4rpx 4rpx;
  font-size: 24rpx;
  color: #2f4361;
}

.count-loaded {
  color: #7b91a6;
}

/* ---- 卡片网格 ---- */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.poke-card {
  width: calc(50% - 10rpx);
  padding: 16rpx 16rpx 20rpx;
  position: relative;
}

.poke-no {
  position: absolute;
  top: 12rpx;
  left: 16rpx;
  font-size: 22rpx;
  color: #7b91a6;
  font-weight: 600;
}

.poke-img-wrap {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.poke-img {
  width: 200rpx;
  height: 200rpx;
}

.poke-fallback {
  width: 200rpx;
  height: 200rpx;
}

.poke-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f4361;
  margin-top: 8rpx;
}

.poke-name-en {
  font-size: 22rpx;
  color: #7b91a6;
}

.poke-types {
  display: flex;
  gap: 10rpx;
  margin-top: 8rpx;
}

/* ---- 空结果 ---- */
.empty {
  padding: 120rpx 60rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f4361;
}

.empty-tip {
  font-size: 26rpx;
  color: #7b91a6;
  margin: 16rpx 0 40rpx;
}

.empty-reset {
  display: inline-block;
}

/* ---- 底部 ---- */
.footer {
  text-align: center;
  padding: 20rpx 0 30rpx;
  font-size: 24rpx;
  color: #2f4361;
}

.about-entry {
  text-align: center;
  padding: 20rpx 0 60rpx;
  font-size: 24rpx;
  color: #7b91a6;
  text-decoration: underline;
}

.load-more { width: 100%; padding: 12rpx 24rpx; background: #f3e4b3; color: #2f4361; border: 1rpx solid #afc7da; border-radius: 16rpx; font-size: 28rpx; line-height: 1.8; }
.load-more::after { border: none; }
