# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python bytecode
__pycache__/
*.py[cod]

# Release APKs are published to GitHub Releases; only the historical
# 0.6.2.1 artifact stays tracked. Local verified-* audit folders, design
# mockups and scratch tooling notes stay untracked.
releases/*.apk
releases/verified-*/
docs/mockups/
tools/_app_zh_ids.txt

# Local agent / editor workspaces
.qoder/
.codex-remote-attachments/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.claude/*
!.claude/settings.json
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Kotlin compiler session artifacts
flutter/android/.kotlin/

# Local PKHeX exporter build artifacts
tools/pkhex_encounters/bin/
tools/pkhex_encounters/obj/

# WorkBuddy agent workspace memory
.workbuddy/
.wrangler/
tools/.icon_cache/

# Android release signing material is private and must only be supplied by
# local secure storage or GitHub Actions secrets.
flutter/android/key.properties
flutter/android/*.keystore
flutter/android/*.jks
