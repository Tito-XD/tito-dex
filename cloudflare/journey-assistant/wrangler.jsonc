{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "titodex-journey-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  // Public HTTPS entry point for the optional App/companion integration.
  // A custom domain can replace this after the trial endpoint is verified.
  "workers_dev": true,
  "secrets": {
    "required": ["TAVILY_API_KEY", "CF_ACCOUNT_ID", "CF_AIG_TOKEN"]
  },
  "ai": {
    "binding": "AI"
  },
  // This instance must be created with @cf/baai/bge-m3 as its embedding model.
  // Retrieval remains disabled until AI_SEARCH_ENABLED is explicitly changed.
  "ai_search_namespaces": [
    {
      "binding": "JOURNEY_SEARCH_NAMESPACE",
      "namespace": "tito-dex"
    }
  ],
  // Read-only at runtime. App clients never receive R2 credentials or a direct
  // R2 URL. DEX_CONTENT is used only for bounded exact-version fact lookup;
  // this Worker never mutates the Dex bundle or its production manifest.
  "r2_buckets": [
    {
      "binding": "JOURNEY_CONTENT",
      "bucket_name": "titodex-journey-content"
    },
    {
      "binding": "DEX_CONTENT",
      "bucket_name": "titodex-dex"
    }
  ],
  "ratelimits": [
    {
      "name": "QUESTION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_GATEWAY_ID": "titodex-journey-assistant",
    "AI_SEARCH_ENABLED": "true",
    "CURATED_WEB_ENABLED": "true",
    // The production secret is installed in Worker Secrets Store. Failures
    // remain optional and fall through to the deterministic answer.
    "TAVILY_WEB_ENABLED": "true",
    // Trial-only broader answers: keep the Pokemon-only/source-domain boundary
    // but downgrade failed second-pass verification instead of returning empty.
    "EXPERIMENTAL_BROAD_ANSWERS": "true",
    // BYOK alias is selected explicitly below. Account identity and Gateway
    // Run authentication stay in Worker Secrets Store.
    "DEEPSEEK_NATIVE_SEARCH_ENABLED": "true",
    "DEEPSEEK_NATIVE_PROVIDER": "custom-deepseek-anthropic",
    "DEEPSEEK_NATIVE_KEY_ALIAS": "TitoDex",
    "AI_EXTERNAL_PROVIDER_ENABLED": "false",
    "AI_PROVIDER": "workers-ai",
    "AI_PROVIDER_MODEL": "deepseek-v4-flash",
    "AI_PROVIDER_ENDPOINT": "chat/completions"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    }
  }
}
