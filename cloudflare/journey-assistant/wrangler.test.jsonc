{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "titodex-journey-assistant-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_GATEWAY_ID": "test",
    "AI_SEARCH_ENABLED": "false",
    "CURATED_WEB_ENABLED": "false",
    "AI_EXTERNAL_PROVIDER_ENABLED": "false",
    "AI_PROVIDER": "workers-ai",
    "AI_PROVIDER_MODEL": "deepseek-chat",
    "AI_PROVIDER_ENDPOINT": "chat/completions"
  },
  "r2_buckets": [
    {
      "binding": "JOURNEY_CONTENT",
      "bucket_name": "titodex-journey-content-test"
    }
  ],
  "ratelimits": [
    {
      "name": "QUESTION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
