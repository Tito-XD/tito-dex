{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "titodex-journey-assistant-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_GATEWAY_ID": "test",
    "AI_SEARCH_ENABLED": "false",
    "CURATED_WEB_ENABLED": "false",
    "TAVILY_WEB_ENABLED": "false",
    "EXA_WEB_ENABLED": "false",
    "WEB_SEARCH_PRIMARY": "exa",
    "DEEPSEEK_NATIVE_SEARCH_ENABLED": "false",
    "DEEPSEEK_TEXT_ENABLED": "false",
    "DEEPSEEK_NATIVE_PROVIDER": "custom-deepseek-anthropic",
    "DEEPSEEK_NATIVE_KEY_ALIAS": "TitoDex"
  },
  "r2_buckets": [
    {
      "binding": "JOURNEY_CONTENT",
      "bucket_name": "titodex-journey-content-test"
    },
    {
      "binding": "DEX_CONTENT",
      "bucket_name": "titodex-dex-test"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "QUESTION_BUDGET", "class_name": "QuestionBudget" }] },
  "migrations": [{ "tag": "question-budget-v1", "new_sqlite_classes": ["QuestionBudget"] }],
  "ratelimits": [
    {
      "name": "QUESTION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
