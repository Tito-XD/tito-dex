{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tito-XD/tito-dex/data/extensions/extension_pack_manifest.schema.json",
  "title": "TitoDex installed extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "extensionId",
    "contentVersion",
    "minHostVersion",
    "packageId",
    "capabilities",
    "games",
    "locales",
    "files"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "extensionId": { "const": "journey_assistant" },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "minHostVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "packageId": {
      "const": "com.tito.titodex.extension.journeyassistant"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["progression_hints"] }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "zh-Hans" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "sha256", "contentType"],
        "properties": {
          "path": { "const": "progression_hints.json" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "contentType": { "const": "application/json" }
        }
      }
    }
  }
}
