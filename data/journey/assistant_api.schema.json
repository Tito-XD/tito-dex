{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tito-XD/tito-dex/data/journey/assistant_api.schema.json",
  "title": "TitoDex Journey Assistant API",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "context"],
  "properties": {
    "question": { "type": "string", "minLength": 1, "maxLength": 240 },
    "history": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": { "const": "user" },
              "content": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": { "const": "assistant" },
              "content": { "type": "string", "minLength": 1, "maxLength": 600 }
            }
          }
        ]
      }
    },
    "journeyPacks": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gameFamily", "version", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._-]{0,79}$" },
          "gameFamily": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._-]{0,39}$" },
          "version": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game", "generation", "badgeIds", "milestoneIds", "locale", "parserRevision"],
      "properties": {
        "game": {
          "enum": [
            "general",
            "diamond",
            "pearl",
            "platinum",
            "heartgold",
            "soulsilver",
            "black",
            "white",
            "black-2",
            "white-2",
            "x",
            "y",
            "omega-ruby",
            "alpha-sapphire",
            "sun",
            "moon",
            "ultra-sun",
            "ultra-moon",
            "sword",
            "shield",
            "brilliant-diamond",
            "shining-pearl",
            "legends-arceus",
            "scarlet",
            "violet"
          ]
        },
        "generation": { "enum": [0, 4, 5, 6, 7, 8, 9] },
        "locationId": { "$ref": "#/$defs/id" },
        "badgeIds": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/id" }
        },
        "badgeCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "milestoneIds": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/id" }
        },
        "locale": { "const": "zh-Hans" },
        "parserRevision": { "type": "integer", "minimum": 0 },
        "contextReliability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["game", "location", "badges", "milestones"],
          "properties": {
            "game": { "enum": ["save_verified", "user_selected"] },
            "location": { "enum": ["save_verified", "unknown"] },
            "badges": { "enum": ["save_verified", "count_only", "unknown"] },
            "milestones": { "enum": ["save_verified", "unsupported"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "game": { "const": "general" } } },
          "then": {
            "required": ["contextReliability"],
            "properties": {
              "generation": { "const": 0 },
              "locationId": false,
              "badgeCount": false,
              "badgeIds": { "maxItems": 0 },
              "milestoneIds": { "maxItems": 0 },
              "contextReliability": {
                "properties": {
                  "game": { "const": "user_selected" },
                  "location": { "const": "unknown" },
                  "badges": { "const": "unknown" },
                  "milestones": { "const": "unsupported" }
                }
              }
            }
          },
          "else": { "properties": { "generation": { "minimum": 4 } } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "context": { "properties": { "game": { "const": "general" } } } }
      },
      "then": { "properties": { "journeyPacks": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9_-]+$"
    }
  }
}
