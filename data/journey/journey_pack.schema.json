{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tito-XD/tito-dex/data/journey/journey_pack.schema.json",
  "title": "TitoDex Journey game data pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "gameFamily", "games", "version", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._-]{0,79}$" },
    "gameFamily": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._-]{0,39}$" },
    "games": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/game" } },
    "version": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "sourceAsOf": { "type": "string", "format": "date" },
    "entries": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "game": {
      "enum": [
        "diamond", "pearl", "platinum", "heartgold", "soulsilver",
        "black", "white", "black-2", "white-2", "x", "y",
        "omega-ruby", "alpha-sapphire", "sun", "moon", "ultra-sun",
        "ultra-moon", "sword", "shield", "brilliant-diamond",
        "shining-pearl", "legends-arceus", "scarlet", "violet"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "accessedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "url": { "type": "string", "format": "uri", "maxLength": 600 },
        "accessedAt": { "type": "string", "format": "date" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "labelZh", "reliability"],
      "properties": {
        "type": { "enum": ["badge", "key_item", "milestone"] },
        "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "labelZh": { "type": "string", "minLength": 1, "maxLength": 80 },
        "itemId": { "type": "integer", "minimum": 1 },
        "reliability": { "enum": ["save_verified", "not_currently_parsed"] }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "action", "targetId", "locationId", "instructionZh"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "targetId": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "locationId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "instructionZh": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "games", "generation", "locations", "locationAliases",
        "destinationAliases", "subject", "requirements", "steps",
        "overviewZh", "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "games": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/game" } },
        "generation": { "type": "integer", "minimum": 4, "maximum": 9 },
        "locations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "locationAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "destinationAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "labelZh", "aliases"],
          "properties": {
            "type": { "enum": ["overworld_blocker", "story_blocker", "reference_topic"] },
            "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
            "labelZh": { "type": "string", "minLength": 1, "maxLength": 80 },
            "aliases": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "overviewZh": { "type": "string", "minLength": 1, "maxLength": 180 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    }
  }
}
