{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tito-XD/tito-dex/data/journey/progression_hints.schema.json",
  "title": "TitoDex progression hints",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetVersion": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "accessedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "accessedAt": { "type": "string", "format": "date" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "labelZh", "reliability"],
      "properties": {
        "type": { "enum": ["badge", "key_item", "milestone"] },
        "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "labelZh": { "type": "string", "minLength": 1 },
        "itemId": { "type": "integer", "minimum": 1 },
        "reliability": {
          "enum": ["save_verified", "not_currently_parsed"]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "action", "targetId", "locationId", "instructionZh"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "targetId": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "locationId": { "type": "string", "minLength": 1 },
        "instructionZh": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "games",
        "generation",
        "locations",
        "locationAliases",
        "destinationAliases",
        "subject",
        "requirements",
        "steps",
        "overviewZh",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "games": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "diamond",
              "pearl",
              "platinum",
              "heartgold",
              "soulsilver",
              "black",
              "white",
              "black-2",
              "white-2",
              "x",
              "y",
              "omega-ruby",
              "alpha-sapphire",
              "sun",
              "moon",
              "ultra-sun",
              "ultra-moon",
              "sword",
              "shield",
              "brilliant-diamond",
              "shining-pearl",
              "legends-arceus",
              "scarlet",
              "violet"
            ]
          }
        },
        "generation": { "type": "integer", "minimum": 4, "maximum": 9 },
        "locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "locationAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "destinationAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "labelZh", "aliases"],
          "properties": {
            "type": { "enum": ["overworld_blocker", "story_blocker"] },
            "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
            "labelZh": { "type": "string", "minLength": 1 },
            "aliases": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "overviewZh": { "type": "string", "minLength": 1, "maxLength": 180 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
